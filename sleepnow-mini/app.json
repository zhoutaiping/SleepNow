{
  "pages": [
    "pages/home/home",
    "pages/sounds/sounds",
    "pages/player/player",
    "pages/sleep-log/sleep-log",
    "pages/settings/settings",
    "pages/login/login",
    "pages/chat/chat",
    "pages/stats/stats"
  ],
  "window": {
    "navigationBarTitleText": "晚安开关",
    "navigationBarBackgroundColor": "@navBg",
    "navigationBarTextStyle": "@navFront",
    "backgroundColor": "@windowBg",
    "backgroundTextStyle": "@windowTextStyle",
    "darkmode": true
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelected",
    "backgroundColor": "@tabBg",
    "borderStyle": "@tabBorder",
    "list": [
      {
        "pagePath": "pages/home/home",
        "text": "首页",
        "iconPath": "@tabHome",
        "selectedIconPath": "@tabHomeOn"
      },
      {
        "pagePath": "pages/sounds/sounds",
        "text": "音频",
        "iconPath": "@tabSounds",
        "selectedIconPath": "@tabSoundsOn"
      },
      {
        "pagePath": "pages/sleep-log/sleep-log",
        "text": "记录",
        "iconPath": "@tabLog",
        "selectedIconPath": "@tabLogOn"
      },
      {
        "pagePath": "pages/chat/chat",
        "text": "陪伴",
        "iconPath": "@tabChat",
        "selectedIconPath": "@tabChatOn"
      },
      {
        "pagePath": "pages/settings/settings",
        "text": "我的",
        "iconPath": "@tabMine",
        "selectedIconPath": "@tabMineOn"
      }
    ]
  },
  "themeLocation": "theme.json",
  "requiredBackgroundModes": ["audio"],
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
