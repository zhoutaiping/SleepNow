/* ==========================================================================
   晚安开关 · 黑白灰设计系统 / One theme, two modes
   --------------------------------------------------------------------------
   规范：
   1. 颜色只在 .theme-light / .theme-dark 两处定义，业务样式禁止硬编码色值
   2. 浅色与深色共用同一套语义 token，不允许按页面单独配 palette
   3. --primary 与 --on-primary 必须成对使用，保证两种模式下文字对比度
   4. 无彩色、无渐变、无彩色阴影；层次只靠灰阶 + 1rpx 边框 + 字重
   5. --text-2 / --text-3 为历史别名，与 --text-sub 同灰阶，禁止再引入新别名
   ========================================================================== */

page {
  /* 与主题无关的尺度 token，挂在 page 上供所有子元素继承 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --radius-pill: 999rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  background: transparent; /* 窗口底色由 wx.setBackgroundColor 同步，避免切换时露白 */
  -webkit-font-smoothing: antialiased;
}

/* ---------- Light · 纸白 ---------- */
.theme-light {
  --bg: #f4f4f4;
  --card: #ffffff;
  --surface: #eaeaea;
  --text: #111111;
  --text-sub: #5c5c5c;
  --text-2: #5c5c5c;
  --text-3: #767676;
  --border: #d9d9d9;
  --divider: #e4e4e4;
  --primary: #111111;
  --on-primary: #ffffff;
  --primary-soft: #e8e8e8;
  --scrim: rgba(0, 0, 0, 0.45);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
}

/* ---------- Dark · 墨黑 ---------- */
.theme-dark {
  --bg: #0b0b0b;
  --card: #191919;
  --surface: #262626;
  --text: #f2f2f2;
  --text-sub: #a6a6a6;
  --text-2: #a6a6a6;
  --text-3: #8c8c8c;
  --border: #333333;
  --divider: #2a2a2a;
  --primary: #f2f2f2;
  --on-primary: #0b0b0b;
  --primary-soft: #2b2b2b;
  --scrim: rgba(0, 0, 0, 0.68);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
}

/* ---------- 基础组件 ---------- */
button {
  border-radius: var(--radius-sm);
  font-weight: 500;
}
button::after { border: none; } /* 去掉小程序默认 1px 边框，保持黑白克制 */

.page {
  padding: 32rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.card {
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.6rpx;
}

.text-sub {
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.65;
}

.cta {
  background: var(--primary);
  color: var(--on-primary);
  margin-top: 16rpx;
  font-weight: 600;
}

.state {
  text-align: center;
  color: var(--text-sub);
  padding: 80rpx 0;
  font-size: 28rpx;
  line-height: 1.7;
}

.num {
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.5rpx;
}

/* 无障碍：尊重系统减弱动效 */
@media (prefers-reduced-motion: reduce) {
  .disc.spin { animation: none !important; }
  .bar { transition: none !important; }
}
