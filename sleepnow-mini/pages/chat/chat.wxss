/* 陪伴页 v2 · 全部走 app.wxss 语义 token，零硬编码色值 / 零渐变 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  color: var(--text);
}

/* ---------- 顶部 ---------- */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 12rpx;
}
.header-left { display: flex; align-items: center; gap: 14rpx; }
.chat-title { font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; }
.ai-badge {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--text-sub);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-pill);
  padding: 4rpx 14rpx;
}
.header-clear { flex: none; }

.model-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 32rpx 0;
  padding: 24rpx 28rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
}
.model-label { font-size: 26rpx; color: var(--text-sub); }
.model-right { display: flex; align-items: center; }
.model-value {
  font-size: 26rpx;
  font-weight: 600;
  max-width: 300rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.model-hint {
  display: block;
  font-size: 20rpx;
  color: var(--text-3);
  margin: 10rpx 36rpx 0;
}

.guest-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 32rpx 0;
  padding: 20rpx 28rpx;
  background: var(--surface);
  border-radius: var(--radius-sm);
}
.guest-text { font-size: 22rpx; color: var(--text-sub); flex: 1; }
.guest-go { font-size: 22rpx; font-weight: 600; flex: none; margin-left: 16rpx; }

/* ---------- 消息区 ---------- */
.msg-scroll { flex: 1; padding: 8rpx 32rpx 24rpx; box-sizing: border-box; }

.welcome { padding: 48rpx 0 12rpx; }
.welcome-hint { display: block; margin-top: 14rpx; }

.scene-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 28rpx; }
.scene-card {
  width: calc((100% - 16rpx) / 2);
  box-sizing: border-box;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
}
.scene-card.active { border: 3rpx solid var(--text); padding: 26rpx; }
.scene-top { display: flex; align-items: center; justify-content: space-between; }
.scene-no { font-size: 22rpx; color: var(--text-3); letter-spacing: 1rpx; font-variant-numeric: tabular-nums; }
.scene-go { font-size: 28rpx; color: var(--text-3); }
.scene-name { display: block; font-size: 32rpx; font-weight: 700; margin-top: 32rpx; letter-spacing: -0.5rpx; }
.scene-desc { display: block; font-size: 22rpx; color: var(--text-sub); margin-top: 10rpx; line-height: 1.5; }

.quick-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.quick-chip {
  padding: 16rpx 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.4;
}
.disclaimer-block {
  display: block;
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1.6;
  margin-top: 40rpx;
  text-align: center;
}

.msg-row { display: flex; flex-direction: column; margin-bottom: 32rpx; }
.msg-row.user { align-items: flex-end; }
.msg-row.assistant { align-items: flex-start; }
.msg-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: var(--text-3);
  margin-bottom: 10rpx;
}
.msg-ai {
  border: 1rpx solid var(--border);
  border-radius: var(--radius-pill);
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  font-weight: 700;
}
.msg-time { font-variant-numeric: tabular-nums; }

.bubble {
  max-width: 86%;
  padding: 24rpx 28rpx;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
  word-break: break-word;
}
.bubble.user { background: var(--primary); color: var(--on-primary); border-bottom-right-radius: 6rpx; }
.bubble.assistant {
  background: var(--card);
  color: var(--text);
  border: 1rpx solid var(--border);
  border-bottom-left-radius: 6rpx;
}
.bubble.blocked { border-left: 6rpx solid var(--text); }
.bubble-text { display: block; }

.typing { display: flex; align-items: center; gap: 8rpx; }
.dot { width: 10rpx; height: 10rpx; border-radius: var(--radius-pill); background: var(--text-3); }
.typing-text { font-size: 22rpx; color: var(--text-3); margin-left: 12rpx; }

/* ---------- 场景切换条 ---------- */
.scene-tabs {
  white-space: nowrap;
  padding: 0 32rpx 16rpx;
  box-sizing: border-box;
  flex: none;
}
.scene-tab {
  display: inline-block;
  padding: 14rpx 26rpx;
  margin-right: 12rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  color: var(--text-sub);
}
.scene-tab.active {
  background: var(--primary);
  color: var(--on-primary);
  font-weight: 600;
}

/* ---------- 错误条 ---------- */
.error-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 32rpx 16rpx;
  padding: 20rpx 24rpx;
  background: var(--surface);
  border-left: 6rpx solid var(--text);
  border-radius: var(--radius-sm);
}
.error-text { font-size: 24rpx; color: var(--text); flex: 1; }
.error-retry { font-size: 24rpx; font-weight: 700; margin-left: 16rpx; text-decoration: underline; flex: none; }

/* ---------- 输入区：严格单行的三元素输入栏 ---------- */
.composer {
  flex: none;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  background: var(--bg);
}
.composer-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 28rpx;
  margin-bottom: 12rpx;
}
.composer-quota, .composer-count { font-size: 20rpx; color: var(--text-3); font-variant-numeric: tabular-nums; }
.composer-live { display: flex; align-items: center; }
.live-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: var(--radius-pill);
  background: var(--text);
  animation: voice-pulse 1.2s ease-in-out infinite;
}
@keyframes voice-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
.live-cancel {
  font-size: 20rpx;
  color: var(--text-sub);
  margin-left: 14rpx;
  text-decoration: underline;
}

/* 麦克风 / 输入框 / 发送按钮：三者同一基线、同一高度，整栏只占一行 */
.composer-row { display: flex; align-items: center; gap: 12rpx; }
.voice-btn {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--border);
  background: var(--card);
}
.voice-btn.active {
  background: var(--primary);
  color: var(--on-primary);
  border-color: var(--primary);
}
/* 纯 CSS 麦克风：不用 emoji / 不用图片，深浅主题都随 token 反相 */
.mic { position: relative; width: 32rpx; height: 44rpx; }
.mic-cap {
  position: absolute; left: 9rpx; top: 0;
  width: 14rpx; height: 24rpx;
  border-radius: 7rpx;
  background: var(--text);
}
.mic-arc {
  position: absolute; left: 2rpx; top: 14rpx;
  width: 28rpx; height: 24rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--text);
  border-top: none;
  border-radius: 0 0 14rpx 14rpx;
}
.mic-stem {
  position: absolute; left: 15rpx; top: 36rpx;
  width: 3rpx; height: 6rpx;
  background: var(--text);
}
.mic-base {
  position: absolute; left: 8rpx; top: 41rpx;
  width: 17rpx; height: 3rpx;
  border-radius: 2rpx;
  background: var(--text);
}
.voice-btn.active .mic-cap,
.voice-btn.active .mic-stem,
.voice-btn.active .mic-base { background: var(--on-primary); }
.voice-btn.active .mic-arc { border-color: var(--on-primary); }

.input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
}
.input-ph { color: var(--text-3); }
.send-btn {
  flex: none;
  width: 112rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  background: var(--primary);
  color: var(--on-primary);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}
.send-btn.stop {
  background: var(--surface);
  color: var(--text);
  border: 1rpx solid var(--border);
}
.composer-disclaimer {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 14rpx;
}

@media (prefers-reduced-motion: reduce) {
  .live-dot { animation: none; }
}

/* ---------- 模型弹层 ---------- */
.sheet-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: var(--scrim);
  display: flex;
  align-items: flex-end;
  z-index: 50;
}
.sheet {
  width: 100%;
  background: var(--card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-title { text-align: center; font-size: 26rpx; color: var(--text-sub); margin-bottom: 20rpx; }
.sheet-item { padding: 26rpx; text-align: center; font-size: 28rpx; border-radius: var(--radius-sm); }
.sheet-item.active { background: var(--surface); color: var(--text); font-weight: 700; }
.sheet-safety { text-align: center; font-size: 20rpx; color: var(--text-3); padding: 16rpx 0; }
.sheet-cancel { margin-top: 16rpx; padding: 26rpx; text-align: center; font-size: 28rpx; color: var(--text-sub); }
