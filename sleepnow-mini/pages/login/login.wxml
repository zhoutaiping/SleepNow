<view class="page">
  <view class="hero">
    <text class="title">{{title}}</text>
    <text class="sub">登录后数据多设备同步、长期保留</text>
  </view>

  <button class="primary" loading="{{logging}}" bindtap="onWechat">{{wechatText}}</button>

  <view class="divider"><text>或</text></view>

  <view class="phone-box">
    <view class="phone-input">
      <text class="prefix">+86</text>
      <input class="input" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" maxlength="11" />
    </view>
    <text wx:if="{{phoneError}}" class="err">{{phoneError}}</text>
    <view class="code-row">
      <input class="code-input" placeholder="验证码" value="{{code}}" bindinput="onCodeInput" maxlength="6" />
      <button class="code-btn" disabled="{{sending || countdown > 0}}" bindtap="onSendCode">
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </button>
    </view>
    <button class="primary" loading="{{logging}}" bindtap="onPhoneLogin" disabled="{{!codeSent}}">{{phoneText}}</button>
  </view>

  <button class="guest" bindtap="onGuest">{{guestText}}</button>
</view>
