.mine-eyebrow { margin: 12rpx 0 20rpx; }

/* 身份 Hero */
.profile-hero { padding: 36rpx; }
.profile-top { display: flex; align-items: center; }
.avatar {
  width: 112rpx; height: 112rpx;
  flex: none;
  margin-right: 28rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--on-primary);
  color: var(--on-primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 46rpx; font-weight: 700;
  box-sizing: border-box;
}
.profile-info { flex: 1; min-width: 0; }
.profile-name { display: block; font-size: 38rpx; font-weight: 700; letter-spacing: -0.5rpx; }
.profile-desc { display: block; font-size: 22rpx; color: var(--on-primary-dim); margin-top: 10rpx; line-height: 1.5; }
.profile-cta { margin-top: 32rpx; height: 84rpx; line-height: 84rpx; }
.hero-btn-ghost {
  background: transparent;
  color: var(--on-primary);
  border: 2rpx solid var(--on-primary);
  box-sizing: border-box;
}

/* 成就数据 */
.ov-unit { font-size: 22rpx; font-weight: 500; color: var(--text-sub); margin-left: 4rpx; letter-spacing: 0; }

/* 外观分组 */
.setting-card { padding: 32rpx; }
.group-label { display: block; font-size: 24rpx; font-weight: 600; color: var(--text-sub); }
.seg { display: flex; gap: 16rpx; margin-top: 18rpx; }
.seg-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  font-size: 26rpx;
}
.seg-item.on {
  background: var(--primary);
  color: var(--on-primary);
  border-color: var(--primary);
  font-weight: 600;
}
.seg-divider { height: 1rpx; background: var(--divider); margin: 32rpx 0; }
.theme-state {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--divider);
}
.theme-state-label { font-size: 24rpx; color: var(--text-sub); }
.theme-state-value { font-size: 24rpx; color: var(--text); font-weight: 600; }
.theme-desc { display: block; margin-top: 12rpx; font-size: 22rpx; color: var(--text-3); line-height: 1.6; }
