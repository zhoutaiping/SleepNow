.page { padding: 32rpx; }
.hero { padding: 20rpx 0 40rpx; }
.hero-title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.35;
}
.hero-sub {
  display: block;
  margin-top: 12rpx;
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.6;
}
.card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.sound-row { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.sound-chip {
  background: var(--surface);
  color: var(--text);
  border: 1rpx solid var(--border);
  padding: 16rpx 30rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
}
.streak-box { display: flex; align-items: center; gap: 20rpx; margin-top: 14rpx; }
.checkin-btn {
  background: var(--primary);
  color: var(--on-primary);
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 28rpx;
  margin: 0;
  line-height: 56rpx;
  height: 56rpx;
}
.checkin-btn.done {
  background: var(--surface);
  color: var(--text-sub);
  border: 1rpx solid var(--border);
}
