/* 首页专属布局。B14：压缩 Hero 与纵向节奏，让「本周打卡 + 周条」进入首屏；
   B10：Hero 次级文字用 --on-primary-dim（AA 对比度），环形段用 --on-primary-track；
   B15：横向音卡片给 scroll-view 加溢出兜底，避免撑破页面宽度。 */
.topbar { padding: 8rpx 0 24rpx; }
.hero-title { margin-top: 10rpx; }
.hero-sub-line { display: block; margin-top: 10rpx; font-size: 24rpx; color: var(--text-sub); }

/* Hero 环形：24 段小条绕中心排布，无渐变、无彩色 */
.hero-head { display: flex; justify-content: space-between; align-items: baseline; }
.ring { position: relative; width: 240rpx; height: 240rpx; margin: 12rpx auto 4rpx; }
.ring-seg {
  position: absolute;
  left: 50%; top: 50%;
  width: 8rpx; height: 26rpx;
  margin: -13rpx 0 0 -4rpx;
  border-radius: var(--radius-pill);
  background: var(--on-primary-track);
  transform-origin: 50% 50%;
}
.ring-seg.on { background: var(--on-primary); }
.ring-center {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.ring-value { font-size: 38rpx; font-weight: 700; letter-spacing: -1rpx; }
.ring-caption { font-size: 22rpx; margin-top: 8rpx; color: var(--on-primary-dim); }
.hero-meta { display: flex; justify-content: space-between; font-size: 22rpx; padding: 4rpx 0 20rpx; }
.hero-btn-hint { display: block; text-align: center; font-size: 22rpx; margin-top: 12rpx; color: var(--on-primary-dim); }

/* 横向助眠卡片 */
.sound-scroll {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden; /* scroll-view 内部横向滚动，外层不允许撑破页面 */
}
.sound-card {
  display: inline-block;
  position: relative;
  width: 240rpx; height: 220rpx;
  margin-right: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
  vertical-align: top;
  white-space: normal;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-md);
}
.sound-no { font-size: 22rpx; color: var(--text-3); }
.sound-play { position: absolute; right: 24rpx; top: 24rpx; font-size: 22rpx; }
.sound-card-bottom { position: absolute; left: 24rpx; right: 24rpx; bottom: 24rpx; }
.sound-name { display: block; font-size: 30rpx; font-weight: 700; }
.sound-desc { display: block; font-size: 22rpx; color: var(--text-sub); margin-top: 8rpx; }

/* 首页空态比通用样式更轻：标题用次级灰 */
.empty-panel .empty-title { color: var(--text-sub); font-size: 26rpx; font-weight: 500; }

/* 近 7 天睡眠时长柱状图（健身 App 的每周训练时长范式，黑白灰、无渐变） */
.chart-panel { padding: 28rpx 24rpx 24rpx; }
.chart-bars { display: flex; align-items: flex-end; justify-content: space-between; height: 200rpx; }
.chart-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.chart-val {
  font-size: 22rpx; color: var(--text-sub);
  height: 30rpx; line-height: 30rpx; margin-bottom: 8rpx;
  font-variant-numeric: tabular-nums;
}
.chart-track {
  flex: 1; width: 100%;
  display: flex; align-items: flex-end; justify-content: center;
  background: var(--surface);
  border-radius: var(--radius-sm);
  overflow: hidden;
}
.chart-fill {
  width: 56%;
  min-height: 4rpx;
  background: transparent;
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  transition: height 280ms ease;
}
.chart-fill.on { background: var(--text); } /* 空日不画假数据，仅灰底轨道可见 */
.chart-label { font-size: 22rpx; color: var(--text-sub); margin-top: 12rpx; }
.chart-foot {
  display: block; text-align: center;
  font-size: 22rpx; color: var(--text-3);
  margin-top: 18rpx; line-height: 1.6;
}

/* 连续签到徽章：健身 App 的 streak 激励 */
.streak-row { display: flex; align-items: center; margin: -4rpx 4rpx 8rpx; }
.streak-dot {
  width: 12rpx; height: 12rpx;
  margin-right: 12rpx;
  background: var(--text);
  border-radius: var(--radius-pill);
}
.streak-text { font-size: 24rpx; font-weight: 600; color: var(--text); }
