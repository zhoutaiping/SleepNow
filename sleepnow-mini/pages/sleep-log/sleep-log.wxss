.head { display: flex; justify-content: space-between; align-items: flex-end; padding: 12rpx 0 32rpx; }
.head-text { flex: 1; min-width: 0; }
.head-text .big-title { margin-top: 12rpx; font-size: 44rpx; }
.add-pill {
  flex: none;
  background: var(--primary);
  color: var(--on-primary);
  font-size: 24rpx;
  font-weight: 600;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 26rpx;
  margin: 0 0 4rpx 20rpx;
  border-radius: var(--radius-pill);
}

.panel-label { display: block; font-size: 22rpx; color: var(--text-sub); margin-bottom: 24rpx; }
.week-panel { margin-bottom: 16rpx; }

.overview-panel { margin-bottom: 16rpx; }
.quick-panel { padding: 8rpx 32rpx; }
.state { padding: 48rpx 0; }
.state-btn { margin-top: 20rpx; background: var(--primary); color: var(--on-primary); }
.guest-hint { display: block; font-size: 20rpx; color: var(--text-3); text-align: center; margin-top: 32rpx; }

/* 记录表单 */
.modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--scrim);
  display: flex;
  align-items: flex-end;
  z-index: 99;
}
.modal-card {
  width: 100%;
  background: var(--card);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx;
  box-sizing: border-box;
}
.modal-title { font-size: 32rpx; font-weight: 700; display: block; margin-bottom: 24rpx; }
.field {
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 28rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
}
.rating-row { display: flex; gap: 16rpx; margin: 16rpx 0 24rpx; }
.star { font-size: 48rpx; color: var(--text-3); }
.star.on { color: var(--text); font-weight: 700; }
.modal-actions { display: flex; gap: 20rpx; }
.modal-actions button { flex: 1; }
.modal-actions button:last-child { background: var(--primary); color: var(--on-primary); font-weight: 600; }
.note-field {
  width: 100%;
  background: var(--bg);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-sm);
  padding: 20rpx;
  margin: 8rpx 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 120rpx;
}
